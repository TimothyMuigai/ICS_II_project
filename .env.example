# Optional. If unset, the extractive fallback generator is used (no API calls).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Paths (relative to project root). Override if you move things.
CHROMA_DIR=./chroma_db
SYNTHETIC_DIR=./data/synthetic_large
REAL_DIR=./data/real
COLLECTION_SYN=kenya_syn_large
COLLECTION_REAL=kenya_real
